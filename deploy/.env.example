# Copy to .env and fill in your values:  cp .env.example .env
#
# PUBLIC_* are the hostnames your Cloudflare tunnel maps to each demo's port.
# The QR codes are regenerated from these at container startup, so they must be
# the URLs a phone can actually reach. Use HTTPS hostnames from your tunnel.

PUBLIC_HUB=https://qr.example.com
PUBLIC_A=https://qr-a.example.com
PUBLIC_B=https://qr-b.example.com
PUBLIC_C=https://qr-c.example.com
PUBLIC_D=https://qr-d.example.com
PUBLIC_E=https://qr-e.example.com

# Secret that protects Demo C's admin toggle: /admin?token=...
ADMIN_TOKEN=please-change-me

# Demo E — Wi-Fi join QR. These are for YOUR OWN access point.
WIFI_SSID=Conference_Free_WiFi
WIFI_AUTH=WPA
WIFI_PASSWORD=letmein-demo-2026

# Optional: override the in-container ports (rarely needed; change host-side
# port mappings in docker-compose.yml instead).
# PORT_HUB=10000
# PORT_A=10001
# PORT_B=10002
# PORT_C=10003
# PORT_D=10004
# PORT_E=10005
